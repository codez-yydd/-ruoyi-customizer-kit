VITE_BASE=/

# 生产接口前缀：与若依 ruoyi-ui 的 VUE_APP_BASE_API=/prod-api 保持一致，
# 这样 Nginx 只需一套 location /prod-api/ 反代模板（见 templates/ruoyi-vue/nginx）。
# 打包后会写入 dist/_app.config.js → window._VBEN_ADMIN_PRO_APP_CONF_
VITE_GLOB_API_URL=/prod-api

# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=none

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式
VITE_ROUTER_HISTORY=hash

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip
VITE_ARCHIVER=true
