    "service": "ruoyi-modules/ruoyi-gen/src/main/resources/vm/java/service.java.vm",
    "service_impl": "ruoyi-modules/ruoyi-gen/src/main/resources/vm/java/serviceImpl.java.vm",
    "xml_mapper": "ruoyi-modules/ruoyi-gen/src/main/resources/vm/xml/mapper.xml.vm"
  },
  "long_id_annotation": "@JsonSerialize(using = ToStringSerializer.class)"
}
