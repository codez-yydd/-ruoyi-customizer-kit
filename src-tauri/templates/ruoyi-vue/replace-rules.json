{
  "exclude_dirs": [
    ".git",
    ".idea",
    ".vscode",
    "node_modules",
    "dist",
    "target",
    "logs"
  ],
  "text_extensions": [
    ".java",
    ".xml",
    ".yml",
    ".yaml",
    ".properties",
    ".sql",
    ".md",
    ".vue",
    ".js",
    ".ts",
    ".json",
    ".bat",
    ".sh",
    ".vm",
    ".html",
    ".imports",
    ".factories"
  ],
  "binary_extensions": [
    ".class",
    ".jar",
    ".war",
    ".zip",
    ".7z",
    ".rar",
    ".png",
    ".jpg",
    ".jpeg",
    ".gif",
    ".ico",
    ".woff",
    ".woff2",
    ".ttf",
    ".eot"
  ]
}
