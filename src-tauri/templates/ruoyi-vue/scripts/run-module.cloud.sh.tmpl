#!/bin/bash
# {{PROJECT_NAME}} Cloud {{SERVICE_NAME}} 开发启动脚本
# 用法：./run-{{SERVICE_NAME}}.sh

export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8
export JAVA_TOOL_OPTIONS="-Dfile.encoding=UTF-8 -Dsun.jnu.encoding=UTF-8 -Dstdout.encoding=UTF-8 -Dstderr.encoding=UTF-8"

APP_HOME="$(cd "$(dirname "$0")" && pwd)"

echo "========== 请先确认 Nacos 可达：http://127.0.0.1:8848/nacos/ =========="
echo "========== Maven install {{SERVICE_NAME}} 及依赖模块 =========="
cd "$APP_HOME" || {
    echo "cd APP_HOME failed!"
    exit 1
}
mvn clean install -DskipTests -pl "{{SERVICE_DIR}}" -am

if [ $? -ne 0 ]; then
    echo "Maven install failed!"
    exit 1
fi

cd "$APP_HOME/{{SERVICE_DIR}}" || {
    echo "cd {{SERVICE_DIR}} failed!"
    exit 1
}

echo "========== Start {{SERVICE_NAME}} =========="
mvn spring-boot:run{{MVN_EXTRA_ARGS}}

if [ $? -ne 0 ]; then
    echo "spring-boot:run failed!"
    exit 1
fi
