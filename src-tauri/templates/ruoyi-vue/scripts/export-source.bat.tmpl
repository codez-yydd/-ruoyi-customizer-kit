@echo off
chcp 65001 >nul
setlocal enabledelayedexpansion
REM {{MODULE_PREFIX}} clean source export script (generated by RuoYi Forge)
REM
REM Packs clean project source into {{MODULE_PREFIX}}-source-<date>.zip at the
REM project root, ready to hand over to customers. Excluded automatically:
REM   - frontend deps and build output: node_modules / dist / dist-ssr
REM   - backend Maven target/ folders (every module, any depth)
REM   - RuoYi Forge runtime output: .ry-forge-report / .ry-customizer-backup
REM   - misc (gitignore-equivalent): .git / .idea / .vscode / logs / *.log /
REM     *.class / *.local / .DS_Store / uploadPath
REM
REM Usage: double-click or run export-source.bat
REM Strategy: if .git exists and git is available, export by git manifest
REM           (honors .gitignore strictly, includes untracked new files);
REM           otherwise copy via robocopy with a builtin exclude list.
REM NOTE: keep this file ASCII-only. UTF-8 Chinese in .bat breaks cmd.exe
REM       on Chinese Windows (GBK parse), causing "not recognized" errors.
REM       The archive name uses the module prefix (validated ASCII), not the
REM       project name (may be Chinese), so generated files stay ASCII.
REM       Requires Windows 10 1803+ (built-in tar.exe creates the zip).

cd /d "%~dp0"

set "ARCHIVE_NAME={{MODULE_PREFIX}}"

REM Locale-independent date (yyyyMMdd) via PowerShell; %date% slicing is locale-dependent
for /f %%i in ('powershell -NoProfile -Command "Get-Date -Format yyyyMMdd"') do set "DATE=%%i"
set "OUT=%ARCHIVE_NAME%-source-%DATE%.zip"

set "STAGE_ROOT=%TEMP%\forge-export-%RANDOM%"
set "STAGE=%STAGE_ROOT%\%ARCHIVE_NAME%"
mkdir "%STAGE%" >nul 2>nul

REM Remove old export archives so they never get packed again
if exist "%ARCHIVE_NAME%-source-*.zip" del /Q "%ARCHIVE_NAME%-source-*.zip" >nul

REM Built-in tar.exe check (Windows 10 1803+)
where tar.exe >nul 2>nul
if errorlevel 1 (
    echo [ERROR] tar.exe not found. Windows 10 1803+ is required.
    goto :FAIL
)

set "USE_GIT=0"
if exist ".git" (
    where git >nul 2>nul
    if not errorlevel 1 set "USE_GIT=1"
)

if "%USE_GIT%"=="1" goto :GIT_MODE
goto :COPY_MODE

:GIT_MODE
echo ========== Collect source by git manifest ==========
REM core.quotepath=false keeps non-ASCII filenames unescaped.
REM findstr chain drops build artifacts and RuoYi Forge runtime output even if
REM .gitignore rules are missing (report contains sensitive data):
REM   1st: substring match, any depth (node_modules/, /target/, /dist/ ...)
REM   2nd: /B root-level dirs (target/, dist/, logs/ ...)
REM   3rd: /E file suffixes (*.log, *.class, *.local, .DS_Store)
git -c core.quotepath=false ls-files --cached --others --exclude-standard ^| findstr /V /C:"node_modules/" /C:".ry-forge-report/" /C:".ry-customizer-backup/" /C:"/target/" /C:"/dist/" /C:"/dist-ssr/" /C:"/logs/" /C:"/.idea/" /C:"/.vscode/" /C:"/uploadPath/" ^| findstr /V /B /C:"target/" /C:"dist/" /C:"dist-ssr/" /C:"logs/" /C:".idea/" /C:".vscode/" /C:"uploadPath/" ^| findstr /V /E /C:".log" /C:".class" /C:".local" /C:".DS_Store" > "%STAGE_ROOT%\files.txt"
if errorlevel 1 (
    echo [WARN] git ls-files failed or manifest empty, fallback to copy mode
    goto :COPY_MODE
)
for /f %%c in ('type "%STAGE_ROOT%\files.txt" ^| find /c /v ""') do set "FILE_COUNT=%%c"
if "%FILE_COUNT%"=="0" (
    echo [WARN] git file manifest is empty, fallback to copy mode
    goto :COPY_MODE
)
REM Stage via a tar file (line-based -T list, each line is one full path);
REM a dirty index (deleted-but-listed files) makes tar fail -> fallback to copy mode
tar -cf "%STAGE_ROOT%\stage.tar" -T "%STAGE_ROOT%\files.txt"
if errorlevel 1 (
    echo [WARN] tar stage failed (dirty git index?), fallback to copy mode
    goto :COPY_MODE
)
tar -xf "%STAGE_ROOT%\stage.tar" -C "%STAGE%"
if errorlevel 1 (
    echo [ERROR] tar extract failed
    goto :FAIL
)
goto :PACK

:COPY_MODE
echo ========== Collect source by builtin exclude list ==========
REM robocopy /XD excludes directories by name at ANY depth (covers every module target/)
robocopy "%CD%" "%STAGE%" /E /NFL /NDL /NJH /NJS /NP /XD node_modules target dist dist-ssr .git .idea .vscode logs uploadPath .turbo .cache .nitro .output .ry-forge-report .ry-customizer-backup /XF *.log *.class *.local .DS_Store "%ARCHIVE_NAME%-source-*.zip" >nul
if errorlevel 8 (
    echo [ERROR] robocopy failed ^(errorlevel !errorlevel!^)
    goto :FAIL
)
goto :PACK

:PACK
echo ========== Pack zip ==========
tar -a -cf "%OUT%" -C "%STAGE_ROOT%" "%ARCHIVE_NAME%"
if errorlevel 1 (
    echo [ERROR] pack zip failed
    goto :FAIL
)

set "COUNT=0"
for /f %%c in ('dir /S /B /A:-D "%STAGE%" 2^>nul ^| find /c /v ""') do set "COUNT=%%c"

echo.
echo [DONE] Export finished: %OUT% (%COUNT% files)
echo        Excluded: node_modules / target / dist / .git / IDE files / logs
if exist "%STAGE_ROOT%" rmdir /S /Q "%STAGE_ROOT%" >nul 2>nul
endlocal
pause
exit /b 0

:FAIL
if exist "%STAGE_ROOT%" rmdir /S /Q "%STAGE_ROOT%" >nul 2>nul
echo [ERROR] Export failed.
endlocal
pause
exit /b 1
