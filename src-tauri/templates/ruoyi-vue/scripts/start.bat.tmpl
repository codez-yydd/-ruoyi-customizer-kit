@echo off
chcp 65001 >nul
REM {{MODULE_PREFIX}} backend start script (Windows, generated by RuoYi Forge)
REM Usage: double-click or scripts\start.bat
REM
REM NOTE: keep this file ASCII-only. UTF-8 Chinese in .bat breaks cmd.exe
REM       on Chinese Windows (GBK parse).

setlocal enabledelayedexpansion

cd /d "%~dp0\.."

set JAR_PATH=
if exist ".\{{MODULE_PREFIX}}-admin\target" (
  for %%f in (".\{{MODULE_PREFIX}}-admin\target\{{MODULE_PREFIX}}-admin*.jar") do (
    echo %%f | findstr /v "\.original" >nul && set "JAR_PATH=%%f"
  )
)
if not defined JAR_PATH (
  for %%f in (".\{{MODULE_PREFIX}}-admin*.jar") do (
    echo %%f | findstr /v "\.original" >nul && set "JAR_PATH=%%f"
  )
)

if not defined JAR_PATH (
  echo [ERROR] Cannot find {{MODULE_PREFIX}}-admin*.jar, run mvn package first
  pause
  exit /b 1
)

set SERVER_PORT={{SERVER_PORT}}
set JAVA_OPTS=-Xms512m -Xmx1024m -Dfile.encoding=UTF-8 -Dserver.port=%SERVER_PORT%

if not exist logs mkdir logs

netstat -ano | findstr ":%SERVER_PORT% " | findstr "LISTENING" >nul
if not errorlevel 1 (
  echo [WARN] Port %SERVER_PORT% already in use. Run scripts\stop.bat first
  pause
  exit /b 1
)

echo [INFO] Starting !JAR_PATH! on port %SERVER_PORT%, log: logs\start.log
start "RuoYi-{{MODULE_PREFIX}}" /B java %JAVA_OPTS% -jar "!JAR_PATH!" > logs\start.log 2>&1

echo [OK] Started
echo      View log: type logs\start.log
echo      Stop: scripts\stop.bat
endlocal
