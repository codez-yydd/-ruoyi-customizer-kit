@echo off
chcp 65001 >nul
REM {{MODULE_PREFIX}} backend dev script (generated by RuoYi Forge)
REM Usage: double-click or run.bat
REM
REM NOTE: keep this file ASCII-only. UTF-8 Chinese in .bat breaks cmd.exe
REM       on Chinese Windows (GBK parse).

set JAVA_TOOL_OPTIONS=-Dfile.encoding=UTF-8 -Dsun.jnu.encoding=UTF-8 -Dstdout.encoding=UTF-8 -Dstderr.encoding=UTF-8

echo ========== Maven install ==========
call mvn clean install -DskipTests

if errorlevel 1 (
    echo [ERROR] Maven install failed!
    pause
    exit /b 1
)

echo ========== Start ==========

cd {{MODULE_PREFIX}}-admin

REM Force ANSI colored logs for Cursor / VS Code terminals
call mvn spring-boot:run -Dspring-boot.run.jvmArguments="-Dspring.output.ansi.enabled=ALWAYS"
