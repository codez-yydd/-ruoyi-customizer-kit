#!/bin/bash
# {{PROJECT_NAME}} Cloud 多服务停止脚本（Linux/macOS）
# 由若依锻造台 RuoYi Forge 自动生成

APP_HOME="$(cd "$(dirname "$0")/.." && pwd)"
cd "$APP_HOME"

stop_one() {
  local name="$1"
  local pid_file="logs/${name}.pid"
  if [ -f "$pid_file" ]; then
    PID=$(cat "$pid_file")
    if kill -0 "$PID" >/dev/null 2>&1; then
      echo "⏹ 停止 $name PID=$PID"
      kill "$PID" 2>/dev/null || true
      sleep 1
      kill -9 "$PID" >/dev/null 2>&1 || true
    fi
    rm -f "$pid_file"
  fi
}

for name in gateway auth system gen job file monitor; do
  stop_one "$name"
done

# 回退：按已解析模块端口清理
for port in {{GATEWAY_PORT}} {{AUTH_PORT}} {{SYSTEM_PORT}} {{GEN_PORT}} {{JOB_PORT}} {{FILE_PORT}} {{MONITOR_PORT}}; do
  if [ -n "$port" ]; then
    PIDS=$(lsof -ti :$port -sTCP:LISTEN 2>/dev/null || true)
    if [ -n "$PIDS" ]; then
      echo "⏹ 按端口 $port 停止：$PIDS"
      echo "$PIDS" | xargs kill 2>/dev/null || true
    fi
  fi
done

echo "✅ Cloud 服务已停止"
