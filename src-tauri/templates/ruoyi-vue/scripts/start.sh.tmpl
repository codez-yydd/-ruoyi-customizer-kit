#!/bin/bash
# {{PROJECT_NAME}} 后端服务启动脚本（Linux/macOS）
# 由若依锻造台 RuoYi Forge 自动生成
#
# 用法：
#   ./start.sh            后台启动
#   ./start.sh --foreground   前台启动（看实时日志）

set -e

# 项目根目录（脚本所在目录）
APP_HOME="$(cd "$(dirname "$0")/.." && pwd)"
cd "$APP_HOME"

# jar 包名（与模块前缀联动）
JAR_FILE="{{MODULE_PREFIX}}-admin.jar"
JAR_PATH="./{{MODULE_PREFIX}}-admin/target/$JAR_FILE"

# 如果 target 下没有，尝试根目录
if [ ! -f "$JAR_PATH" ]; then
  JAR_PATH="$JAR_FILE"
fi

if [ ! -f "$JAR_PATH" ]; then
  echo "❌ 找不到 $JAR_FILE，请先执行 mvn package 打包"
  exit 1
fi

# 端口（与 Nginx 配置 / 配置文件保持一致）
SERVER_PORT={{SERVER_PORT}}

# JVM 参数（按需调整）
JAVA_OPTS="-Xms512m -Xmx1024m -Dfile.encoding=UTF-8"
JAVA_OPTS="$JAVA_OPTS -Dserver.port=$SERVER_PORT"

mkdir -p logs

# 判断端口是否被占用
if lsof -i :$SERVER_PORT -sTCP:LISTEN >/dev/null 2>&1; then
  echo "⚠️  端口 $SERVER_PORT 已被占用，请先执行 ./scripts/stop.sh"
  exit 1
fi

if [ "$1" = "--foreground" ]; then
  echo "▶ 前台启动 $JAR_FILE（端口 $SERVER_PORT）"
  exec java $JAVA_OPTS -jar "$JAR_PATH"
else
  echo "▶ 后台启动 $JAR_FILE（端口 $SERVER_PORT），日志输出到 logs/start.log"
  nohup java $JAVA_OPTS -jar "$JAR_PATH" > logs/start.log 2>&1 &
  echo $! > logs/{{MODULE_PREFIX}}.pid
  echo "✅ 已启动，PID: $(cat logs/{{MODULE_PREFIX}}.pid)"
  echo "   查看日志：tail -f logs/start.log"
  echo "   停止服务：./scripts/stop.sh"
fi
