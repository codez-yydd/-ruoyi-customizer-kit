@echo off
chcp 65001 >nul
REM {{MODULE_PREFIX}} Cloud stop script (Windows, generated by RuoYi Forge)
REM NOTE: keep this file ASCII-only.

setlocal

call :stop_port {{GATEWAY_PORT}}
call :stop_port {{AUTH_PORT}}
call :stop_port {{SYSTEM_PORT}}
call :stop_port {{GEN_PORT}}
call :stop_port {{JOB_PORT}}
call :stop_port {{FILE_PORT}}
call :stop_port {{MONITOR_PORT}}

echo [OK] Cloud ports stopped
echo [INFO] Stop leftover Cloud jars from Task Manager if needed
endlocal
goto :eof

:stop_port
if "%~1"=="" goto :eof
set PORT=%~1
echo [INFO] Stopping processes on port %PORT%
set FOUND=0
for /f "tokens=5" %%a in ('netstat -ano ^| findstr ":%PORT% " ^| findstr "LISTENING"') do (
  echo [INFO] Stopping PID=%%a
  taskkill /PID %%a /F >nul 2>&1
  set FOUND=1
)
if "%FOUND%"=="0" (
  echo [INFO] No process listening on port %PORT%
)
goto :eof
