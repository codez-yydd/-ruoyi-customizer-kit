@echo off
chcp 65001 >nul
REM {{MODULE_PREFIX}} Cloud stop script (Windows, generated by RuoYi Forge)
REM NOTE: keep this file ASCII-only.

setlocal
set SERVER_PORT={{SERVER_PORT}}

echo [INFO] Stopping processes on gateway port %SERVER_PORT%
set FOUND=0
for /f "tokens=5" %%a in ('netstat -ano ^| findstr ":%SERVER_PORT% " ^| findstr "LISTENING"') do (
  echo [INFO] Stopping PID=%%a
  taskkill /PID %%a /F >nul 2>&1
  set FOUND=1
)

if "%FOUND%"=="0" (
  echo [INFO] No process listening on port %SERVER_PORT%
) else (
  echo [OK] Gateway port stopped
)
echo [INFO] Stop other Cloud jars from Task Manager if needed
endlocal
