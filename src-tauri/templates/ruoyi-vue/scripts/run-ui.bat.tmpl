@echo off
chcp 65001 >nul
REM {{MODULE_PREFIX}} frontend dev script (generated by RuoYi Forge)
REM Usage: double-click or run-ui.bat
REM Detect: pnpm-workspace.yaml -> pnpm run dev:ele ; else npm run dev
REM
REM NOTE: keep this file ASCII-only. UTF-8 Chinese in .bat breaks cmd.exe
REM       on Chinese Windows (GBK parse).

cd /d "%~dp0"

set "FRONTEND_DIR={{MODULE_PREFIX}}-ui"

echo ========== Start Frontend ==========

if not exist "%FRONTEND_DIR%" (
    echo [ERROR] Frontend dir not found: %FRONTEND_DIR%
    pause
    exit /b 1
)

cd /d "%FRONTEND_DIR%"

if exist "pnpm-workspace.yaml" goto :VBEN_DEV
goto :RUOYI_DEV

:VBEN_DEV
where pnpm.cmd >nul 2>nul
if errorlevel 1 (
    echo [ERROR] pnpm not found. Install: npm install -g pnpm
    pause
    exit /b 1
)
if not exist "node_modules" (
    echo ---------- pnpm install ----------
    call pnpm.cmd install
    if errorlevel 1 (
        echo [ERROR] pnpm install failed!
        pause
        exit /b 1
    )
)
echo ---------- pnpm run dev:ele ----------
call pnpm.cmd run dev:ele
goto :eof

:RUOYI_DEV
if not exist "node_modules" (
    echo ---------- npm install ----------
    call npm install
    if errorlevel 1 (
        echo [ERROR] npm install failed!
        pause
        exit /b 1
    )
)
echo ---------- npm run dev ----------
call npm run dev
