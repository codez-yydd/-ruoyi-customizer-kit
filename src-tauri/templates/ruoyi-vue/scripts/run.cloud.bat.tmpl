@echo off
chcp 65001 >nul
REM {{MODULE_PREFIX}} Cloud dev script (generated by RuoYi Forge)
REM NOTE: keep this file ASCII-only.

set JAVA_TOOL_OPTIONS=-Dfile.encoding=UTF-8 -Dsun.jnu.encoding=UTF-8 -Dstdout.encoding=UTF-8 -Dstderr.encoding=UTF-8

echo ========== Check Nacos http://127.0.0.1:8848/nacos/ ==========
echo ========== Maven install ==========
call mvn clean install -DskipTests

if errorlevel 1 (
    echo [ERROR] Maven install failed!
    pause
    exit /b 1
)

echo ========== Cloud start order: gateway - auth - system - others ==========
echo Gateway port: {{SERVER_PORT}}
echo Use scripts\start.bat or run spring-boot:run in each module
pause
