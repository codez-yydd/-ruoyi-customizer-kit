@echo off
chcp 65001 >nul
setlocal enabledelayedexpansion
REM {{MODULE_PREFIX}} one-click build script (generated by RuoYi Forge)
REM
REM Output folder (project root):
REM   build\
REM     {{MODULE_PREFIX}}-admin.jar
REM     dist\
REM
REM Usage: double-click or run build.bat
REM Frontend: vben monorepo -> pnpm run build:ele
REM           classic ruoyi-ui -> npm run build:prod
REM
REM NOTE: keep this file ASCII-only. UTF-8 Chinese in .bat breaks cmd.exe
REM       on Chinese Windows (GBK parse), causing "not recognized" errors.

cd /d "%~dp0"

set "JAVA_TOOL_OPTIONS=-Dfile.encoding=UTF-8 -Dsun.jnu.encoding=UTF-8"
set "FRONTEND_DIR={{MODULE_PREFIX}}-ui"
set "FRONTEND_DIST="

echo ========== Maven package ==========
call mvn clean package -DskipTests
if errorlevel 1 (
    echo [ERROR] Maven package failed!
    pause
    exit /b 1
)

echo ========== Frontend build ==========
if not exist "%FRONTEND_DIR%" (
    echo [WARN] Frontend dir not found: %FRONTEND_DIR%, skip frontend build
    goto :ASSEMBLE
)

cd /d "%FRONTEND_DIR%"

if exist "pnpm-workspace.yaml" goto :VBEN_BUILD
goto :RUOYI_BUILD

:VBEN_BUILD
where pnpm.cmd >nul 2>nul
if errorlevel 1 (
    echo [ERROR] pnpm not found. Install: npm install -g pnpm
    pause
    exit /b 1
)
if not exist "node_modules" (
    echo ---------- pnpm install ----------
    call pnpm.cmd install
    if errorlevel 1 (
        echo [ERROR] pnpm install failed!
        pause
        exit /b 1
    )
)
echo ---------- pnpm run build:ele ----------
call pnpm.cmd run build:ele
if errorlevel 1 (
    echo [ERROR] Frontend build failed!
    pause
    exit /b 1
)
cd /d "%~dp0"
set "FRONTEND_DIST=%FRONTEND_DIR%\apps\web-ele\dist"
goto :ASSEMBLE

:RUOYI_BUILD
if not exist "node_modules" (
    echo ---------- npm install ----------
    call npm install
    if errorlevel 1 (
        echo [ERROR] npm install failed!
        pause
        exit /b 1
    )
)
echo ---------- npm run build:prod ----------
call npm run build:prod
if errorlevel 1 (
    echo [ERROR] Frontend build failed!
    pause
    exit /b 1
)
cd /d "%~dp0"
set "FRONTEND_DIST=%FRONTEND_DIR%\dist"
goto :ASSEMBLE

:ASSEMBLE
echo ========== Assemble build\ ==========
if not exist build mkdir build

set "JAR_PATH="
set "JAR_NAME="
for %%f in (".\{{MODULE_PREFIX}}-admin\target\{{MODULE_PREFIX}}-admin*.jar") do (
    echo %%f | findstr /v "\.original" >nul
    if not errorlevel 1 (
        set "JAR_PATH=%%f"
        set "JAR_NAME=%%~nxf"
    )
)
if not defined JAR_PATH (
    echo [ERROR] Cannot find {{MODULE_PREFIX}}-admin*.jar
    pause
    exit /b 1
)
copy /Y "!JAR_PATH!" "build\" >nul
echo [OK] Copied jar: build\!JAR_NAME!

if not defined FRONTEND_DIST (
    if exist "%FRONTEND_DIR%\apps\web-ele\dist" set "FRONTEND_DIST=%FRONTEND_DIR%\apps\web-ele\dist"
)
if not defined FRONTEND_DIST (
    if exist "%FRONTEND_DIR%\dist" set "FRONTEND_DIST=%FRONTEND_DIR%\dist"
)
if defined FRONTEND_DIST (
    if exist "!FRONTEND_DIST!" (
        if exist "build\dist" rmdir /S /Q "build\dist"
        xcopy /E /I /Y "!FRONTEND_DIST!" "build\dist" >nul
        echo [OK] Copied frontend dist: build\dist
    ) else (
        echo [WARN] Frontend dist path missing, skip copy
    )
) else (
    echo [WARN] Frontend dist not found, skip copy
)

echo.
echo [DONE] Build finished. Artifacts are under build\
endlocal
pause
