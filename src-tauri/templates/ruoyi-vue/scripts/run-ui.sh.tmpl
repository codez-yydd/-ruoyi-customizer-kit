#!/bin/bash
# {{PROJECT_NAME}} 前端开发脚本（依赖安装 + 启动），由若依锻造台自动生成
# 用法：./run-ui.sh

# 项目根目录（脚本所在目录）
APP_HOME="$(cd "$(dirname "$0")" && pwd)"
cd "$APP_HOME"

FRONTEND_DIR="{{MODULE_PREFIX}}-ui"

echo "========== Start Frontend =========="

if [ ! -d "$FRONTEND_DIR" ]; then
    echo "❌ 未找到前端目录 $FRONTEND_DIR"
    exit 1
fi

cd "$FRONTEND_DIR"

# 首次启动需安装依赖
if [ ! -d "node_modules" ]; then
    echo "---------- npm install ----------"
    npm install
    if [ $? -ne 0 ]; then
        echo "npm install failed!"
        exit 1
    fi
fi

echo "---------- npm run dev ----------"
npm run dev
