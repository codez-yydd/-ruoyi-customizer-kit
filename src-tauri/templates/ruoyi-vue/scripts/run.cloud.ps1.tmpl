# {{MODULE_PREFIX}} Cloud dev script (generated by RuoYi Forge)
# NOTE: keep this file ASCII-only.
# Scan run-*.bat at runtime (exclude run-ui); official order first, then extras.
# Arrow-key checkbox menu: pick first, then mvn install, then start selected services.

$ErrorActionPreference = 'Continue'
$Root = $PSScriptRoot
if ([string]::IsNullOrEmpty($Root)) {
    $Root = Split-Path -Parent $MyInvocation.MyCommand.Path
}
Set-Location -LiteralPath $Root

$env:JAVA_TOOL_OPTIONS = '-Dfile.encoding=UTF-8 -Dsun.jnu.encoding=UTF-8 -Dstdout.encoding=UTF-8 -Dstderr.encoding=UTF-8'

$Official = @('gateway', 'auth', 'system', 'gen', 'job', 'file', 'monitor')
$Names = New-Object 'System.Collections.Generic.List[string]'

function Add-IfNew([string]$Cand) {
    if ([string]::IsNullOrWhiteSpace($Cand)) { return }
    foreach ($n in $Names) {
        if ($n -eq $Cand) { return }
    }
    [void]$Names.Add($Cand)
}

foreach ($s in $Official) {
    $p = Join-Path $Root ("run-{0}.bat" -f $s)
    if (Test-Path -LiteralPath $p) {
        Add-IfNew $s
    }
}

Get-ChildItem -Path $Root -Filter 'run-*.bat' -File -ErrorAction SilentlyContinue | ForEach-Object {
    $bn = $_.BaseName
    if ($bn -ieq 'run-ui') { return }
    if ($bn.Length -le 4) { return }
    $svc = $bn.Substring(4)
    Add-IfNew $svc
}

function Restore-Cursor {
    try { [Console]::CursorVisible = $true } catch { }
}

if ($Names.Count -eq 0) {
    Write-Host '[WARN] no run-*.bat services found (run-ui excluded)'
    Write-Host 'Press any key to exit...'
    try { [void][Console]::ReadKey($true) } catch { Read-Host | Out-Null }
    exit 1
}

$Checked = New-Object 'bool[]' $Names.Count
for ($i = 0; $i -lt $Names.Count; $i++) { $Checked[$i] = $true }
$Cursor = 0
$Hint = ''
$Quit = $false
$Confirmed = $false

try {
    try { [Console]::CursorVisible = $false } catch { }

    while (-not $Confirmed -and -not $Quit) {
        Clear-Host
        Write-Host 'Check Nacos http://127.0.0.1:8848/nacos/'
        Write-Host 'Gateway port: {{GATEWAY_PORT}}'
        Write-Host 'Up/Down=move  Space=toggle  A=all  N=none  Enter=start  Esc=quit'
        Write-Host ''
        for ($i = 0; $i -lt $Names.Count; $i++) {
            $mark = if ($Checked[$i]) { '[x]' } else { '[ ]' }
            $line = ('{0} {1}' -f $mark, $Names[$i])
            if ($i -eq $Cursor) {
                Write-Host $line -ForegroundColor Cyan
            } else {
                Write-Host $line
            }
        }
        if (-not [string]::IsNullOrEmpty($Hint)) {
            Write-Host ''
            Write-Host $Hint -ForegroundColor Yellow
        }

        $key = [Console]::ReadKey($true)
        $Hint = ''
        switch ($key.Key.ToString()) {
            'UpArrow' {
                if ($Cursor -gt 0) { $Cursor-- }
            }
            'DownArrow' {
                if ($Cursor -lt ($Names.Count - 1)) { $Cursor++ }
            }
            'Spacebar' {
                $Checked[$Cursor] = -not $Checked[$Cursor]
            }
            'A' {
                for ($i = 0; $i -lt $Checked.Length; $i++) { $Checked[$i] = $true }
            }
            'N' {
                for ($i = 0; $i -lt $Checked.Length; $i++) { $Checked[$i] = $false }
            }
            'Enter' {
                $any = $false
                foreach ($c in $Checked) { if ($c) { $any = $true; break } }
                if (-not $any) {
                    $Hint = 'Select at least one service'
                } else {
                    $Confirmed = $true
                }
            }
            'Escape' { $Quit = $true }
            'Q' { $Quit = $true }
        }
    }
}
finally {
    Restore-Cursor
}

if ($Quit -or -not $Confirmed) {
    exit 0
}

Clear-Host
Write-Host '========== Check Nacos http://127.0.0.1:8848/nacos/ =========='
Write-Host '========== Maven install =========='
& cmd.exe /c 'mvn clean install -DskipTests'
if ($LASTEXITCODE -ne 0) {
    Write-Host '[ERROR] Maven install failed!'
    Write-Host 'Press any key to exit...'
    try { [void][Console]::ReadKey($true) } catch { Read-Host | Out-Null }
    exit 1
}

Write-Host '========== Start in list order =========='
# Child cmd inherits this env; do not pass SKIP via Start-Process ArgumentList quoting.
$env:SKIP_MVN_INSTALL = '1'
for ($i = 0; $i -lt $Names.Count; $i++) {
    if (-not $Checked[$i]) { continue }
    $name = $Names[$i]
    Write-Host ("[INFO] start {0}" -f $name)
    $cmdLine = 'start "RuoYi-{0}" /D "{1}" cmd /k call run-{0}.bat' -f $name, $Root
    Start-Process -FilePath 'cmd.exe' -WorkingDirectory $Root -ArgumentList @('/c', $cmdLine)
    Start-Sleep -Seconds 5
}

Write-Host '[OK] start commands issued'
Write-Host 'Press any key to exit...'
try { [void][Console]::ReadKey($true) } catch { Read-Host | Out-Null }
exit 0
