@echo off
chcp 65001 >nul
REM {{MODULE_PREFIX}} Cloud start script (Windows, generated by RuoYi Forge)
REM Start order: gateway -> auth -> system -> others
REM NOTE: keep this file ASCII-only.

setlocal enabledelayedexpansion
cd /d "%~dp0\.."

echo [INFO] Check Nacos at http://127.0.0.1:8848/nacos/ before starting

if not exist logs mkdir logs

set GATEWAY_PORT={{SERVER_PORT}}

call :start_one gateway "{{MODULE_PREFIX}}-gateway" %GATEWAY_PORT%
timeout /t 2 /nobreak >nul
call :start_one auth "{{MODULE_PREFIX}}-auth" 0
timeout /t 2 /nobreak >nul
if exist "{{MODULE_PREFIX}}-modules\{{MODULE_PREFIX}}-system" (
  call :start_one system "{{MODULE_PREFIX}}-modules\{{MODULE_PREFIX}}-system" 0
)
timeout /t 2 /nobreak >nul
if exist "{{MODULE_PREFIX}}-modules\{{MODULE_PREFIX}}-gen" call :start_one gen "{{MODULE_PREFIX}}-modules\{{MODULE_PREFIX}}-gen" 0
if exist "{{MODULE_PREFIX}}-modules\{{MODULE_PREFIX}}-job" call :start_one job "{{MODULE_PREFIX}}-modules\{{MODULE_PREFIX}}-job" 0
if exist "{{MODULE_PREFIX}}-modules\{{MODULE_PREFIX}}-file" call :start_one file "{{MODULE_PREFIX}}-modules\{{MODULE_PREFIX}}-file" 0
if exist "{{MODULE_PREFIX}}-visual\{{MODULE_PREFIX}}-monitor" call :start_one monitor "{{MODULE_PREFIX}}-visual\{{MODULE_PREFIX}}-monitor" 0

echo [OK] Cloud start commands issued, logs in logs\
echo      Stop: scripts\stop.bat
endlocal
goto :eof

:start_one
set NAME=%~1
set SEARCH=%~2
set PORT=%~3
set JAR_PATH=
if exist ".\%SEARCH%\target" (
  for %%f in (".\%SEARCH%\target\*.jar") do (
    echo %%f | findstr /v "\.original" >nul && set "JAR_PATH=%%f"
  )
)
if not defined JAR_PATH (
  echo [WARN] skip %NAME%: jar not found, run mvn package first
  goto :eof
)
set JAVA_OPTS=-Xms256m -Xmx512m -Dfile.encoding=UTF-8
if not "%PORT%"=="0" set JAVA_OPTS=%JAVA_OPTS% -Dserver.port=%PORT%
echo [INFO] Starting %NAME% !JAR_PATH!
start "RuoYi-%NAME%" /B java %JAVA_OPTS% -jar "!JAR_PATH!" > logs\%NAME%.log 2>&1
goto :eof
