@echo off
chcp 65001 >nul
REM {{MODULE_PREFIX}} backend stop script (Windows, generated by RuoYi Forge)
REM Usage: double-click or scripts\stop.bat
REM Kill process listening on SERVER_PORT (no PID file on Windows).
REM
REM NOTE: keep this file ASCII-only. UTF-8 Chinese in .bat breaks cmd.exe
REM       on Chinese Windows (GBK parse).

setlocal

set SERVER_PORT={{SERVER_PORT}}

echo [INFO] Looking for process on port %SERVER_PORT%
set FOUND=0
for /f "tokens=5" %%a in ('netstat -ano ^| findstr ":%SERVER_PORT% " ^| findstr "LISTENING"') do (
  echo [INFO] Stopping PID=%%a
  taskkill /PID %%a /F >nul 2>&1
  set FOUND=1
)

if "%FOUND%"=="0" (
  echo [INFO] No process listening on port %SERVER_PORT%
) else (
  echo [OK] Stopped
)
endlocal
