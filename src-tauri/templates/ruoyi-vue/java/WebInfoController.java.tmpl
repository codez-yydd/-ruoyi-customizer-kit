package {{PACKAGE}}.web.controller.common;

import java.util.HashMap;
import java.util.Map;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;
import {{PACKAGE}}.common.config.RuoYiConfig;
import {{PACKAGE}}.common.core.domain.AjaxResult;
import {{PACKAGE}}.common.utils.StringUtils;
import {{PACKAGE}}.system.service.ISysConfigService;

/**
 * 网站公开信息（免登录）
 *
 * 供前端展示版权年份、ICP 备案号、站点标题与 Logo，SecurityConfig 已放行 /webInfo。
 * 站点信息在「后台设置 → 站点设置」页面维护（存 sys_config），备案号 DB 无值时回退
 * application.yaml 的 ruoyi.icp，标题/Logo 空值由前端回退打包默认。
 *
 * @author ruoyi
 */
@RestController
@RequestMapping("/webInfo")
public class WebInfoController
{
    @Autowired
    private RuoYiConfig ruoyiConfig;

    @Autowired
    private ISysConfigService configService;

    /**
     * 获取网站公开信息（版权起始年份、ICP备案号、站点标题、后台Logo）
     */
    @GetMapping
    public AjaxResult getWebInfo()
    {
        Map<String, Object> data = new HashMap<>();
        data.put("copyrightYear", ruoyiConfig.getCopyrightYear());
        data.put("title", configService.selectConfigByKey("sys.site.title"));
        data.put("logo", configService.selectConfigByKey("sys.site.logo"));
        // ICP 备案号：后台设置页（DB）优先，无值回退 yaml 的 ruoyi.icp
        String icp = configService.selectConfigByKey("sys.site.icp");
        data.put("icp", StringUtils.isNotEmpty(icp) ? icp : ruoyiConfig.getIcp());
        return AjaxResult.success(data);
    }
}
