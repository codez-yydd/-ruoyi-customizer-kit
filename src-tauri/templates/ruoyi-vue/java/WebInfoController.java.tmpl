package {{PACKAGE}}.web.controller.common;

import java.util.HashMap;
import java.util.Map;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;
import {{PACKAGE}}.common.config.RuoYiConfig;
import {{PACKAGE}}.common.core.domain.AjaxResult;

/**
 * 网站公开信息（免登录）
 *
 * 供前端页脚展示版权年份与 ICP 备案号，SecurityConfig 已放行 /webInfo。
 * 备案号配置在 application.yaml 的 ruoyi.icp，备案通过后填写并重启后端即可生效。
 *
 * @author ruoyi
 */
@RestController
@RequestMapping("/webInfo")
public class WebInfoController
{
    @Autowired
    private RuoYiConfig ruoyiConfig;

    /**
     * 获取网站公开信息（版权起始年份、ICP备案号）
     */
    @GetMapping
    public AjaxResult getWebInfo()
    {
        Map<String, Object> data = new HashMap<>();
        data.put("copyrightYear", ruoyiConfig.getCopyrightYear());
        data.put("icp", ruoyiConfig.getIcp());
        return AjaxResult.success(data);
    }
}
