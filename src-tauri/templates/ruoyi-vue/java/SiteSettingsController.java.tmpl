package {{PACKAGE}}.web.controller.system;

import java.util.HashMap;
import java.util.List;
import java.util.Map;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.security.access.prepost.PreAuthorize;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PutMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;
import {{PACKAGE}}.common.annotation.Log;
import {{PACKAGE}}.common.config.RuoYiConfig;
import {{PACKAGE}}.common.core.controller.BaseController;
import {{PACKAGE}}.common.core.domain.AjaxResult;
import {{PACKAGE}}.common.enums.BusinessType;
import {{PACKAGE}}.common.utils.StringUtils;
import {{PACKAGE}}.system.domain.SysConfig;
import {{PACKAGE}}.system.service.ISysConfigService;

/**
 * 站点设置（标题 / 后台Logo / ICP备案号）
 *
 * 值存 sys_config（sys.site.title / sys.site.logo / sys.site.icp），保存即时生效：
 * 前端经公开接口 /webInfo 读取，标题与 Logo 空值回退打包默认，ICP 空值回退
 * application.yaml 的 ruoyi.icp。
 *
 * @author ruoyi
 */
@RestController
@RequestMapping("/site/settings")
public class SiteSettingsController extends BaseController
{
    private static final String KEY_TITLE = "sys.site.title";
    private static final String KEY_LOGO = "sys.site.logo";
    private static final String KEY_ICP = "sys.site.icp";

    @Autowired
    private ISysConfigService configService;

    @Autowired
    private RuoYiConfig ruoyiConfig;

    /**
     * 获取站点设置
     */
    @PreAuthorize("@ss.hasPermi('site:settings:list')")
    @GetMapping
    public AjaxResult get()
    {
        return AjaxResult.success(buildView());
    }

    /**
     * 保存站点设置（返回最新值，前端据此即时生效）
     */
    @PreAuthorize("@ss.hasPermi('site:settings:edit')")
    @Log(title = "站点设置", businessType = BusinessType.UPDATE)
    @PutMapping
    public AjaxResult update(@RequestBody Map<String, String> body)
    {
        saveConfig(KEY_TITLE, "站点标题", clamp(body.get("title"), 50));
        saveConfig(KEY_LOGO, "后台Logo", clamp(body.get("logo"), 500));
        saveConfig(KEY_ICP, "ICP备案号", clamp(body.get("icp"), 100));
        return AjaxResult.success(buildView());
    }

    private Map<String, Object> buildView()
    {
        Map<String, Object> data = new HashMap<>();
        data.put("title", configService.selectConfigByKey(KEY_TITLE));
        data.put("logo", configService.selectConfigByKey(KEY_LOGO));
        String icp = configService.selectConfigByKey(KEY_ICP);
        data.put("icp", StringUtils.isNotEmpty(icp) ? icp : ruoyiConfig.getIcp());
        return data;
    }

    private String clamp(String value, int max)
    {
        if (value == null)
        {
            return "";
        }
        value = value.trim();
        return value.length() > max ? value.substring(0, max) : value;
    }

    private void saveConfig(String key, String name, String value)
    {
        SysConfig query = new SysConfig();
        query.setConfigKey(key);
        List<SysConfig> exist = configService.selectConfigList(query);
        if (exist.isEmpty())
        {
            SysConfig config = new SysConfig();
            config.setConfigName(name);
            config.setConfigKey(key);
            config.setConfigValue(value);
            config.setConfigType("Y");
            config.setRemark("后台设置页面维护");
            configService.insertConfig(config);
        }
        else
        {
            SysConfig config = exist.get(0);
            config.setConfigValue(value);
            configService.updateConfig(config);
        }
    }
}
